---
interface Props {
  hasNextPage: boolean;
  hasPrevPage: boolean;
  nextPageUrl: string;
  prevPageUrl: string;
  headerTip: string;
}

const { hasNextPage, hasPrevPage, nextPageUrl, prevPageUrl, headerTip } = Astro.props;
---

<nav
  class="mt-8 flex w-full flex-row-reverse items-center justify-between gap-4 text-base md:text-lg"
  aria-label="ترقيم الصفحات"
>
  {
    hasNextPage ? (
      <a
        href={nextPageUrl}
        rel="next"
        class="rounded-md border border-border px-3 py-2 text-text-muted focus-ring transition-colors hover:bg-surface-hover"
      >
        التالي
      </a>
    ) : (
      <span
        class="cursor-not-allowed rounded-md border border-border px-3 py-2 text-text-subtle"
        aria-disabled="true"
      >
        التالي
      </span>
    )
  }
  <p class="text-base text-text-subtle">{headerTip}</p>
  {
    hasPrevPage ? (
      <a
        href={prevPageUrl}
        rel="prev"
        class="rounded-md border border-border px-3 py-2 text-text-muted focus-ring transition-colors hover:bg-surface-hover"
      >
        السابق
      </a>
    ) : (
      <span
        class="cursor-not-allowed rounded-md border border-border px-3 py-2 text-text-subtle"
        aria-disabled="true"
      >
        السابق
      </span>
    )
  }
</nav>
