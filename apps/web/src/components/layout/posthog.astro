<script>
  import * as Sentry from '@sentry/astro';

  declare global {
    interface Window {
      __qafiyahDistinctId?: string;
    }
  }

  const MAX_ATTEMPTS = 50;
  const RETRY_INTERVAL_MS = 200;

  const syncSentryUser = (attempt: number) => {
    if (window.__qafiyahDistinctId) {
      Sentry.setUser({ id: window.__qafiyahDistinctId });
      return;
    }
    if (attempt >= MAX_ATTEMPTS) {
      return;
    }
    setTimeout(() => syncSentryUser(attempt + 1), RETRY_INTERVAL_MS);
  };

  syncSentryUser(0);
</script>
